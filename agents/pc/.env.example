# Anthropic API key for the character's reasoning/dialogue
ANTHROPIC_API_KEY=

# Claude model used for live in-session play (cost/latency scale with every
# voice turn — sonnet is the default; swap to an opus model for max quality)
AI_PC_MODEL=claude-sonnet-5

# Claude model used for cheap background session summarization
AI_PC_SUMMARY_MODEL=claude-haiku-4-5

# Discord bot token
DISCORD_BOT_TOKEN=

# Discord user IDs allowed to run admin/override commands (see REQUIREMENTS.md)
DM_DISCORD_ID=
OWNER_DISCORD_ID=

# Path to the SQLite database file
AI_PC_DB_PATH=./ai_pc.db
