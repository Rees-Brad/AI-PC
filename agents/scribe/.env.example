# Anthropic API key for summarization and queries
ANTHROPIC_API_KEY=

# Summarization is background work - keep it cheap. It should not scale in cost
# with every spoken turn the way live play does.
SCRIBE_MODEL=claude-haiku-4-5

# Discord bot token (the Scribe has its own bot application, separate from
# every PC agent's)
DISCORD_BOT_TOKEN=

# Discord user ID allowed to run DM-only commands (/note, /correct)
DM_DISCORD_ID=

# The one server and the channels this Scribe operates in
SCRIBE_GUILD_ID=
SCRIBE_VOICE_CHANNEL_ID=
SCRIBE_TEXT_CHANNEL_ID=

# The campaign record this Scribe owns. One database is one campaign.
# PC agents point their AI_PC_CAMPAIGN_DB_PATH at this same file (read-only).
CAMPAIGN_DB_PATH=./campaign.db
