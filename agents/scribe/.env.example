# Copy to your Scribe instance directory as .env, or point SCRIBE_ENV_FILE at
# wherever you keep it. Keep this file out of campaign folders and out of git.

# Anthropic API key for summarization
ANTHROPIC_API_KEY=

# Summarization is background work - keep it cheap. It should not scale in cost
# with every spoken turn the way live play does.
SCRIBE_MODEL=claude-haiku-5-5

# A Campaign Agent running copy. When set, the record lives in its .scribe/
# folder and each finalized session's summary is written to its sessions/
# folder. Usually passed per run with --campaign-folder instead.
SCRIBE_CAMPAIGN_FOLDER=

# The campaign record when no campaign folder is set. One database is one
# campaign.
CAMPAIGN_DB_PATH=./campaign.db

# Discord (the bot is not implemented yet). The Scribe has its own bot
# application.
DISCORD_BOT_TOKEN=
# Discord user ID allowed to run DM-only commands (/note, /correct)
DM_DISCORD_ID=
SCRIBE_GUILD_ID=
SCRIBE_VOICE_CHANNEL_ID=
SCRIBE_TEXT_CHANNEL_ID=
